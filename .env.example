# ---------------------------------------------------------------------------
# NF Attendance Register — environment variables
# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase values empty to run the built-in DEMO (fictional data, in memory).
# ---------------------------------------------------------------------------

# demo | live. Set APP_MODE=live in production so missing credentials fail loudly
# instead of ever showing demo data.
APP_MODE=

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key (safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Used solely to create operator accounts from the admin screen.
# Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: signs demo-mode session cookies.
DEMO_SESSION_SECRET=
