{
  "name": "nf-attendance-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS infrastructure for the NF contractor attendance app (AWS CDK). Synthesises CloudFormation; deploys nothing by itself.",
  "scripts": {
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "2.274.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1146.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
